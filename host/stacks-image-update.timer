[Unit]
Description=Daily image update for Dockge compose stacks
Documentation=file:///data/stacks/host/README.md

[Timer]
# Local time (sheeta is America/Sao_Paulo, UTC-3).
# Plan example: after the reboot-if-needed window.
# Confirm root's reboot cron is earlier than this before enabling.
OnCalendar=*-*-* 04:30:00

# If the box was off or rebooting at 04:30, run once after the next boot.
Persistent=true

# Do not require exact-second accuracy.
AccuracySec=1min

[Install]
WantedBy=timers.target
